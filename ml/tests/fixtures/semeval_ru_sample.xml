<!-- Искусственный пример в формате SemEval-2016 Task 5 (SE-ABSA16) для тестов. -->
<Reviews>
  <Review rid="1">
    <sentences>
      <sentence id="1:0">
        <text>Официант был очень вежлив и внимателен.</text>
        <Opinions>
          <Opinion target="Официант" category="SERVICE#GENERAL" polarity="positive" from="0" to="8"/>
        </Opinions>
      </sentence>
      <sentence id="1:1">
        <text>Стейк пережарен, а вино кислое.</text>
        <Opinions>
          <Opinion target="Стейк" category="FOOD#QUALITY" polarity="negative" from="0" to="5"/>
          <Opinion target="вино" category="DRINKS#QUALITY" polarity="negative" from="18" to="22"/>
        </Opinions>
      </sentence>
      <sentence id="1:2">
        <text>Цены приятно удивили.</text>
        <Opinions>
          <Opinion target="Цены" category="RESTAURANT#PRICES" polarity="positive" from="0" to="4"/>
        </Opinions>
      </sentence>
      <sentence id="1:3" OutOfScope="TRUE">
        <text>Мы пришли туда после работы.</text>
      </sentence>
    </sentences>
  </Review>
  <Review rid="2">
    <sentences>
      <sentence id="2:0">
        <text>В зале уютно, играет тихая музыка.</text>
        <Opinions>
          <Opinion target="зале" category="AMBIENCE#GENERAL" polarity="positive" from="2" to="6"/>
        </Opinions>
      </sentence>
      <sentence id="2:1">
        <text>Хороший ресторан рядом с метро.</text>
        <Opinions>
          <Opinion target="ресторан" category="RESTAURANT#GENERAL" polarity="positive" from="8" to="16"/>
        </Opinions>
      </sentence>
      <sentence id="2:2">
        <text>Заказали салат и чай.</text>
        <Opinions/>
      </sentence>
      <sentence id="2:3">
        <text>Порции большие, но дороговато.</text>
        <Opinions>
          <Opinion target="Порции" category="FOOD#STYLE_OPTIONS" polarity="positive" from="0" to="6"/>
          <Opinion target="NULL" category="FOOD#PRICES" polarity="negative" from="0" to="0"/>
        </Opinions>
      </sentence>
    </sentences>
  </Review>
</Reviews>
